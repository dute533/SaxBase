default_target: local

targets:
  local:
    dialect: sqlserver
    connection_env: SAXBASE_LOCAL_DSN
  dev:
    dialect: sqlserver
    connection_env: SAXBASE_DEV_DSN
  acc:
    dialect: sqlserver
    connection_env: SAXBASE_ACC_DSN
  prod:
    dialect: sqlserver
    connection_env: SAXBASE_PROD_DSN
    require_confirmation: true
