# Copy to .env and replace the placeholders. Never commit real credentials.
# URL-encode special characters in usernames and passwords.
SAXBASE_LOCAL_DSN='sqlserver://USER:PASSWORD@localhost:1433?database=app'
SAXBASE_DEV_DSN='sqlserver://USER:PASSWORD@dev-server:1433?database=app'
SAXBASE_ACC_DSN='sqlserver://USER:PASSWORD@acc-server:1433?database=app'
SAXBASE_PROD_DSN='sqlserver://USER:PASSWORD@prod-server:1433?database=app'
